# ===== Backend (Python FastAPI) environment =====
# Salin file ini ke `.env` dan isi nilai sebenarnya. JANGAN commit `.env`.

# API key untuk mengakses endpoint mutasi (wajib diganti)
QA_API_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY

# Server
QA_HOST=0.0.0.0
QA_PORT=8000

# ADB / perangkat
QA_ADB_SERIAL=
QA_ADB_PATH=adb
QA_TARGET_PACKAGE=com.whatsapp
QA_TARGET_ACTIVITY=com.whatsapp.Main

# Profil & snapshot
QA_MAX_PROFILES=100
QA_SNAPSHOT_ROOT=./data/profiles
QA_DEVICE_STAGING_DIR=/data/local/tmp/qa_harness

# LSPosed spoof module
QA_LSPOSED_MODULE_PKG=com.example.spoofmodule
QA_SPOOF_CONFIG_PATH=/data/local/tmp/qa_harness/spoof.json

# Batch delay (detik)
QA_BATCH_DELAY_MIN=5.0
QA_BATCH_DELAY_MAX=10.0

# Logging
QA_LOG_LEVEL=INFO
QA_LOG_DIR=./data/logs
QA_JSON_LOGGING=true

# ===== Firebase (untuk integrasi dashboard/Cloud Functions) =====
# Project ID Firebase — HARUS cocok dengan google-services.json di APK
PROJECT_ID=qa-harness-dev
FUNCTIONS_REGION=asia-southeast1
# Path ke service account key (untuk Firebase Admin SDK)
FIREBASE_CREDENTIALS_PATH=./service-account.json
